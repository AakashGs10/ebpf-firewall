# ── eBPF Shield  ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Grafana admin password (required by docker-compose)
GRAFANA_PASSWORD=changeme

# ── Control Plane (/etc/ebpf-shield.env on the VM) ──────
# Network interface to attach the XDP program to
# IFACE=eth0

# Prometheus metrics listen address
# METRICS_ADDR=:8080

# XDP attach mode: "generic" (works everywhere) or "native" (faster, needs driver support)
# XDP_MODE=generic

# Upload gateway token (leave blank for unauthenticated uploads)
# UPLOAD_TOKEN=

# Set to "1" to auto-ban IPs that upload infected files
# BAN_ON_INFECTED=0

# Block a specific IP at startup (for testing)
# TEST_BLOCK_IP=
